# ==============================================================================
# TrustVault Frontend Environment Configuration
# ==============================================================================
# NOTE: Only variables prefixed with VITE_ are exposed to the browser client!
# 
# CRITICAL SECURITY RULE:
# NEVER put SUPABASE_SERVICE_ROLE_KEY in this file or any frontend file!
# The service-role key has superuser privileges and will compromise the entire
# database if leaked to the browser.
# ==============================================================================

# Backend FastAPI URL
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Supabase Public Configuration (Safe for client-side authentication)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
